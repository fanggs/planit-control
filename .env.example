# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=
# Keep the database password separate from the URI; never commit the real .env.
PGPASSWORD=
# Optional: dedicated private persistent directory (outside page/).
# Local default when blank: data/private_photos/ (gitignored, owner-only).
PLANIT_PRIVATE_PHOTOS_DIR=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
# Exact frontend origins only. Replace with your deployed HTTPS origin in production.
PLANIT_CORS_ORIGINS=http://127.0.0.1:4174,http://127.0.0.1:4175
DEEPSPACE_URL=
PLANIT_NOTIFY_SECRET=
